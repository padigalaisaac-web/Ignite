# ==========================================
# RepoPilot AI - Backend Environment Config
# ==========================================

# Optional: GitHub Personal Access Token (Increases rate limit from 60 to 5,000 req/hr)
GITHUB_TOKEN=

# AI Provider Configuration
# Options: 'ollama' (Local open-weight runner) or 'open_weight' (Cloud OpenAI-compatible endpoint)
AI_PROVIDER=ollama

# Ollama Settings (Local Open-Weight Model)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# Open-Weight Cloud API Settings (Optional alternative: Groq, Together.ai, OpenRouter, vLLM)
OPENAI_API_BASE=https://api.groq.com/openai/v1
OPENAI_API_KEY=
OPENAI_MODEL=llama-3.3-70b-versatile

# Pipeline Controls
MAX_ANALYSIS_FILES=15
MAX_FILE_BYTES=25000
REQUEST_TIMEOUT_SECONDS=60.0
