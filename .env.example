# ========================================================
# RepoPilot AI - Global Environment Configuration Template
# ========================================================

# Backend Configuration (backend/.env)
# ------------------------------------
# Optional: GitHub Personal Access Token (Increases rate limit from 60 to 5,000 req/hr)
GITHUB_TOKEN=

# AI Provider Configuration ('ollama' or 'open_weight')
AI_PROVIDER=ollama

# Local Open-Weight Runner (Ollama)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# Open-Weight Cloud API Alternative (Groq, Together.ai, OpenRouter, vLLM)
OPENAI_API_BASE=https://api.groq.com/openai/v1
OPENAI_API_KEY=
OPENAI_MODEL=llama-3.3-70b-versatile

# Pipeline Controls
MAX_ANALYSIS_FILES=15
MAX_FILE_BYTES=25000
REQUEST_TIMEOUT_SECONDS=60.0

# Frontend Configuration (frontend/.env)
# -------------------------------------
VITE_API_URL=http://localhost:8000
